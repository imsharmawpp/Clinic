# ClinicPro Environment Configuration
# Copy this to .env and update values for your environment

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinicpro
DB_USER=root
DB_PASS=

# Application
APP_URL=https://yourdomain.com
APP_ENV=production
APP_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# Timezone
APP_TIMEZONE=Asia/Kolkata
